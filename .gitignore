# ANCHORED. `build/` and `dist/` on their own match a directory of that name at ANY
# depth, and either would be an ordinary source path in this tree: `src/build/`, `src/dist/`.
#     git check-ignore -v --no-index src/build/plan.ts src/dist/out.ts
# prints nothing, as it must. `tsc -p tsconfig.build.json` is the only thing that writes
# `/dist/`, and nothing writes `/build/`: it is a scratch name kept out of the index.
/build/
/dist/

# Local tool environments. ANCHORED for the same reason, and `env/` was the dangerous one:
# `src/env/` is the natural home for the HOUSTON_* reader, so a bare `env/` would have
# let that file exist on the machine that wrote it and be absent from every clone.
/.venv/
/venv/
/env/

# Local secrets and the output of `npm pack` at the repository root.
/.env
/.env.*
/*.tgz

# Package-manager debug logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/

# houston local state (never commit a user's repros)
.houston/

# graphify's knowledge-graph output (graph.json, graph.html, GRAPH_REPORT.md, caches):
# regenerable, multi-megabyte, one person's reading aid. UNANCHORED on purpose: a run on
# a subfolder also leaves a `graphify-out/cache/` inside the folder it scanned
# (`src/graphify-out/` for a run on `src/`), and nothing in this tree is plausibly a
# source path of that name.
graphify-out/

# Local notes and records: design documents, troubleshooting notes, the migration record
# and its automation kit. ANCHORED: a bare `docs/` would also swallow `data/docs/`, which
# ships in the package -- present on the machine that wrote it, absent from every clone and
# from any package built from one. Nothing under `data/` may be ignored, for that reason.
DESIGN.md
/.docs/

# `.claude/` and `.agents/` hold PERSONAL settings (settings.local.json), local agent
# definitions, hooks and working files -- none of which belong to anybody but their owner.
# Their `skills/` directories are different: the houston skill is a project artifact,
# generated by `tools/skill-generate.js`, and committing it is how a fresh clone teaches an
# agent to drive this tool correctly. So the contents are ignored and that one subdirectory
# is not, which needs `dir/*` rather than `dir/` -- git will not descend into an excluded
# directory to re-include something inside it.
.claude/*
!.claude/skills/
.codex/
.agents/*
!.agents/skills/
CLAUDE.md
AGENTS.md
GEMINI.md

# TypeScript toolchain.
#
# ANCHORED, exactly like `/build/` and `/dist/` above: a bare `node_modules/` would also
# match a fixture path somewhere under `test/fixtures/`, and an ignored fixture is present
# on the machine that wrote it and absent from every clone.
/node_modules/
# `yarn.lock` is TRACKED and deliberately not listed here -- `yarn install --immutable` in
# CI has nothing to be immutable against without it. What yarn writes BESIDE it is machine
# state: the install-state cache and the unplugged/global caches.
/.yarn/*
!/.yarn/patches/
!/.yarn/releases/
!/.yarn/plugins/
/.pnp.*
# Jest's coverage report.
/coverage/

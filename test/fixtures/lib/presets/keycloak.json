{
  "realm_json": "{\n  \"realm\": \"houston\",\n  \"enabled\": true,\n  \"sslRequired\": \"none\",\n  \"clients\": [\n    {\n      \"clientId\": \"houston-saml-sp\",\n      \"protocol\": \"saml\",\n      \"enabled\": true\n    }\n  ],\n  \"users\": [\n    {\n      \"username\": \"user1\",\n      \"enabled\": true,\n      \"emailVerified\": true,\n      \"email\": \"user1@example.com\",\n      \"firstName\": \"User\",\n      \"lastName\": \"1\",\n      \"credentials\": [\n        {\n          \"type\": \"password\",\n          \"value\": \"user1\",\n          \"temporary\": false\n        }\n      ]\n    },\n    {\n      \"username\": \"user2\",\n      \"enabled\": true,\n      \"emailVerified\": true,\n      \"email\": \"user2@example.com\",\n      \"firstName\": \"User\",\n      \"lastName\": \"2\",\n      \"credentials\": [\n        {\n          \"type\": \"password\",\n          \"value\": \"user2\",\n          \"temporary\": false\n        }\n      ]\n    },\n    {\n      \"username\": \"user3\",\n      \"enabled\": true,\n      \"emailVerified\": true,\n      \"email\": \"user3@example.com\",\n      \"firstName\": \"User\",\n      \"lastName\": \"3\",\n      \"credentials\": [\n        {\n          \"type\": \"password\",\n          \"value\": \"user3\",\n          \"temporary\": false\n        }\n      ]\n    }\n  ]\n}",
  "service": [
    {
      "image": "quay.io/keycloak/keycloak:26.0",
      "command": [
        "start-dev",
        "--import-realm"
      ],
      "environment": {
        "KC_BOOTSTRAP_ADMIN_USERNAME": "admin",
        "KC_BOOTSTRAP_ADMIN_PASSWORD": "admin",
        "KC_PROXY_HEADERS": "xforwarded"
      },
      "volumes": [
        "./saml/keycloak-realm.json:/opt/keycloak/data/import/houston-realm.json:ro"
      ],
      "ports": [
        "8081:8080"
      ],
      "restart": "unless-stopped"
    },

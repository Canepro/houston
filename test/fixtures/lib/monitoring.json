{
  "names": {
    "services": [
      "prometheus",
      "grafana",
      "node-exporter",
      "mongodb-exporter",
      "loki",
      "opentelemetry-logs-collector"
    ],
    "volumes": [
      "prometheus_tsdb",
      "grafana_data",
      "loki_data"
    ],
    "setting": "Prometheus_Enabled",
    "env": "OVERWRITE_SETTING_Prometheus_Enabled"
  },
  "volumes": {
    "prometheus_tsdb": {
      "driver": "local"
    },
    "grafana_data": {
      "driver": "local"
    },
    "loki_data": {
      "driver": "local"
    }
  },
  "services": {
    "prometheus": {
      "image": "docker.io/prom/prometheus:v3.4.2",
      "command": [
        "--config.file=/etc/prometheus/prometheus.yml",
        "--web.enable-lifecycle",
        "--storage.tsdb.retention.time=15d",
        "--web.enable-remote-write-receiver"
      ],
      "volumes": [
        "./monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro",
        "./monitoring/file_sd_configs:/etc/prometheus/file_sd_configs:ro",
        "prometheus_tsdb:/prometheus"
      ],
      "ports": [
        "9090:9090"
      ],
      "restart": "unless-stopped"
    },
    "grafana": {
      "image": "docker.io/grafana/grafana:12.0.2",
      "environment": {
        "GF_SECURITY_ADMIN_USER": "admin",
        "GF_SECURITY_ADMIN_PASSWORD": "admin",
        "GF_AUTH_ANONYMOUS_ENABLED": "true",
        "GF_AUTH_ANONYMOUS_ORG_ROLE": "Viewer",
        "GF_SECURITY_ALLOW_EMBEDDING": "true"
      },
      "volumes": [
        "./monitoring/grafana/provisioning:/etc/grafana/provisioning:ro",
        "./monitoring/grafana/dashboards:/dashboards:ro",
        "grafana_data:/var/lib/grafana"
      ],
      "ports": [
        "5050:3000"
      ],
      "depends_on": [
        "prometheus"
      ],
      "restart": "unless-stopped"
    },
    "node-exporter": {
      "image": "docker.io/prom/node-exporter:v1.9.1",
      "command": [
        "--path.procfs=/host/proc",
        "--path.sysfs=/host/sys",
        "--path.rootfs=/rootfs",
        "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
      ],
      "volumes": [
        "/proc:/host/proc:ro",
        "/sys:/host/sys:ro",
        "/:/rootfs:ro"
      ],
      "restart": "unless-stopped"
    },
    "mongodb-exporter": {
      "image": "docker.io/percona/mongodb_exporter:0.43.1",
      "command": [
        "--mongodb.uri=mongodb://mongodb:27017/?directConnection=true",
        "--collect-all",
        "--compatible-mode"
      ],
      "depends_on": [
        "mongodb"
      ],
      "restart": "unless-stopped"
    },
    "loki": {
      "image": "docker.io/grafana/loki:3.6",
      "command": "-config.file=/etc/loki/config.yaml -config.expand-env=true",
      "user": "0",
      "volumes": [
        "./monitoring/loki/config.yaml:/etc/loki/config.yaml:ro",
        "loki_data:/data/loki:rw"
      ],
      "restart": "unless-stopped"
    },
    "opentelemetry-logs-collector": {
      "image": "docker.io/otel/opentelemetry-collector-contrib:0.143.0",
      "command": [
        "--config=/etc/otel-collector-config.yaml"
      ],
      "user": "0",
      "volumes": [
        "./monitoring/otel/config.yaml:/etc/otel-collector-config.yaml:ro",
        "/var/run/docker.sock:/var/run/docker.sock:ro",
        "/var/lib/docker/containers:/hostfs/storage:ro"
      ],
      "depends_on": [
        "loki"
      ],
      "restart": "unless-stopped"
    }
  },
  "bound_ports": {
    "prometheus": {
      "image": "docker.io/prom/prometheus:v3.4.2",
      "command": [
        "--config.file=/etc/prometheus/prometheus.yml",
        "--web.enable-lifecycle",
        "--storage.tsdb.retention.time=15d",
        "--web.enable-remote-write-receiver"
      ],
      "volumes": [
        "./monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro",
        "./monitoring/file_sd_configs:/etc/prometheus/file_sd_configs:ro",
        "prometheus_tsdb:/prometheus"
      ],
      "ports": [
        "127.0.0.1:9090:9090"
      ],
      "restart": "unless-stopped"
    },
    "grafana": {
      "image": "docker.io/grafana/grafana:12.0.2",
      "environment": {
        "GF_SECURITY_ADMIN_USER": "admin",
        "GF_SECURITY_ADMIN_PASSWORD": "admin",
        "GF_AUTH_ANONYMOUS_ENABLED": "true",
        "GF_AUTH_ANONYMOUS_ORG_ROLE": "Viewer",
        "GF_SECURITY_ALLOW_EMBEDDING": "true"
      },
      "volumes": [
        "./monitoring/grafana/provisioning:/etc/grafana/provisioning:ro",
        "./monitoring/grafana/dashboards:/dashboards:ro",
        "grafana_data:/var/lib/grafana"
      ],
      "ports": [
        "127.0.0.1:5050:3000"
      ],
      "depends_on": [
        "prometheus"
      ],
      "restart": "unless-stopped"
    },
    "node-exporter": {
      "image": "docker.io/prom/node-exporter:v1.9.1",
      "command": [
        "--path.procfs=/host/proc",
        "--path.sysfs=/host/sys",
        "--path.rootfs=/rootfs",
        "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
      ],
      "volumes": [
        "/proc:/host/proc:ro",
        "/sys:/host/sys:ro",
        "/:/rootfs:ro"
      ],
      "restart": "unless-stopped"
    },
    "mongodb-exporter": {
      "image": "docker.io/percona/mongodb_exporter:0.43.1",
      "command": [
        "--mongodb.uri=mongodb://mongodb:27017/?directConnection=true",
        "--collect-all",
        "--compatible-mode"
      ],
      "depends_on": [
        "mongodb"
      ],
      "restart": "unless-stopped"
    },
    "loki": {
      "image": "docker.io/grafana/loki:3.6",
      "command": "-config.file=/etc/loki/config.yaml -config.expand-env=true",
      "user": "0",
      "volumes": [
        "./monitoring/loki/config.yaml:/etc/loki/config.yaml:ro",
        "loki_data:/data/loki:rw"
      ],
      "restart": "unless-stopped"
    },
    "opentelemetry-logs-collector": {
      "image": "docker.io/otel/opentelemetry-collector-contrib:0.143.0",
      "command": [
        "--config=/etc/otel-collector-config.yaml"
      ],
      "user": "0",
      "volumes": [
        "./monitoring/otel/config.yaml:/etc/otel-collector-config.yaml:ro",
        "/var/run/docker.sock:/var/run/docker.sock:ro",
        "/var/lib/docker/containers:/hostfs/storage:ro"
      ],
      "depends_on": [
        "loki"
      ],
      "restart": "unless-stopped"
    }
  },
  "paths": [
    "monitoring/prometheus.yml",
    "monitoring/file_sd_configs/rocketchat.yml",
    "monitoring/file_sd_configs/mongo.yml",
    "monitoring/file_sd_configs/node-exporter.yml",
    "monitoring/grafana/provisioning/datasources/prometheus.yml",
    "monitoring/grafana/provisioning/datasources/loki.yml",
    "monitoring/grafana/provisioning/dashboards/from-dir.yml",
    "monitoring/grafana/dashboards/rocketchat-metrics.json",
    "monitoring/grafana/dashboards/node-exporter-full.json",
    "monitoring/grafana/dashboards/mongodb-exporter.json",
    "monitoring/grafana/dashboards/k6-loadtest.json",
    "monitoring/grafana/dashboards/houston-logs.json",
    "monitoring/loki/config.yaml",
    "monitoring/otel/config.yaml"
  ],
